# Скопируйте этот файл в .env.local и задайте реальные значения.

# Логин администратора
ADMIN_LOGIN=admin

# Пароль администратора — используется и для входа, и для подписи сессий.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace_me_with_a_long_random_token

# Vercel Blob — для загрузки файлов и хранения данных.
# Получить: Vercel Dashboard → Storage → Blob Store → .env.local
BLOB_READ_WRITE_TOKEN=
