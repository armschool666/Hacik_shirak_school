# Логин и токен для входа в /admin.
# Скопируйте этот файл в .env.local и задайте реальные значения.

# Логин администратора (произвольная строка)
ADMIN_LOGIN=admin

# Токен/пароль администратора. Должен быть длинным и случайным.
# Можно сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace_me_with_a_long_random_token

# Секрет для подписи JWT-сессий. Должен быть длинным и случайным.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_me_with_a_long_random_secret

# Vercel KV — для хранения материалов.
# Получить: Vercel Dashboard → Storage → Create KV Database → .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob — для загрузки файлов.
# Получить: Vercel Dashboard → Storage → Create Blob Store → .env.local
BLOB_READ_WRITE_TOKEN=
